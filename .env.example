# copy to .env and adjust. VAULT_IP and VAULT_MAC are REQUIRED (compose refuses to start without them).
PUID=99
PGID=100
VAULT_DIR=/mnt/user/data/Documents/Vault
APPDATA_DIR=/mnt/user/appdata/basic-memory
BACKUP_DIR=/mnt/user/appdata/basic-memory/backup
# The container's own LAN identity on the external br0 macvlan.
# VAULT_IP: a FREE address on your LAN, outside the DHCP range (verify with: ping <ip>; arp -a). Clients use http://<VAULT_IP>:27123
# VAULT_MAC: any unique locally administered MAC; the first byte must be 02 (e.g. 02:xx:xx:xx:xx:xx with random hex)
VAULT_IP=192.0.2.10
VAULT_MAC=02:00:00:00:00:01
# Bare git backup remote (path inside the container, or an ssh/https URL). Empty = no push.
COMMITTER_REMOTE=/backup/vault.git
